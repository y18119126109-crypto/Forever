# Local server
PORT=8080
SWAGGER_DESKTOP_PORT=18473
CLAUDIO_CITY=上海
CLAUDIO_LATITUDE=31.2304
CLAUDIO_LONGITUDE=121.4737

# Volcengine Ark Responses API
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-1-pro-260915

# Codex CLI. Authentication is managed by `codex login`, not by this file.
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_TIMEOUT_MS=90000
CODEX_LOGIN_TIMEOUT_MS=300000
CODEX_DEFAULT=0
CODEX_DISABLED=0

# Optional alternative LLM providers. The active provider can be selected in LAB.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=90000

# Claude Code CLI. Set CLAUDE_DISABLED=1 to force the local rules fallback.
CLAUDE_COMMAND=claude
CLAUDE_TIMEOUT_MS=45000
CLAUDE_DISABLED=0

# NetEaseCloudMusicApi. The installed Node module is used by default.
MUSIC_SOURCE=auto
NCM_USE_MODULE=1
NETEASE_COOKIE=
NCM_QUALITY=exhigh
# Optional HTTP sidecar, for example http://localhost:3000
NCM_API_BASE=

# Optional self-hosted QQMusicApi: https://gitee.com/gnnu/QQMusicApi
QQ_MUSIC_API_BASE=http://127.0.0.1:3300
QQ_MUSIC_COOKIE=
QQ_MUSIC_QUALITY=320

# Fish Audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=
FISH_AUDIO_ENDPOINT=https://api.fish.audio/v1/tts

# Volcengine Speech TTS 2.0 / Voice Clone 2.0
# This is a Speech Console API Key, not ARK_API_KEY.
VOLC_TTS_API_KEY=
VOLC_TTS_SPEAKER=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_MODEL=seed-tts-2.0-expressive
VOLC_TTS_STYLE=像深夜电台主持人一样自然、松弛、克制地说话，语速稍慢，句间保留呼吸感。
VOLC_TTS_SPEECH_RATE=-8
VOLC_TTS_LOUDNESS_RATE=0
VOLC_TTS_EMOTION=
VOLC_TTS_EMOTION_SCALE=3

# OpenWeather
OPENWEATHER_API_KEY=

# Calendar bridge returning {"events": [...]}
CALENDAR_CONTEXT_URL=
CALENDAR_CONTEXT_TOKEN=
