{
  "name": "forever-ai-radio",
  "version": "1.3.1",
  "description": "Local-first private AI radio with conversational recommendations and voice interaction.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node src/server.js",
    "desktop": "electron .",
    "desktop:icons": "node scripts/generate-desktop-icons.js",
    "desktop:build:mac": "electron-builder --mac zip --arm64",
    "desktop:build:mac:dmg": "npm run desktop:build:mac && bash scripts/package-macos-dmg.sh arm64",
    "desktop:build:mac:x64": "electron-builder --mac zip --x64",
    "desktop:build:mac:x64:dmg": "npm run desktop:build:mac:x64 && bash scripts/package-macos-dmg.sh x64",
    "desktop:build:win": "electron-builder --win nsis portable --x64",
    "check": "find src public desktop test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/*.test.js",
    "test:codex": "node --test test/codex.test.js"
  },
  "keywords": [],
  "author": "Forever",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "NeteaseCloudMusicApi": "^4.32.0",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.swagger.airadio",
    "productName": "Forever",
    "artifactName": "Forever-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules/sqlite3/**/*"
    ],
    "files": [
      "desktop/**/*",
      "src/**/*",
      "public/**/*",
      "prompts/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!public/uploads/**/*",
      "!.env",
      "!state.db",
      "!cache/**/*",
      "!user/**/*",
      "!test/**/*"
    ],
    "directories": {
      "output": "dist-desktop",
      "buildResources": "build"
    },
    "afterPack": "scripts/after-pack.js",
    "afterSign": "scripts/verify-macos-signature.js",
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "identity": "-",
      "notarize": false,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/app.asar.unpacked/node_modules/sqlite3/build/Release/node_sqlite3.node"
      ],
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Forever-${version}-win-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Forever-${version}-win-${arch}-portable.${ext}"
    }
  }
}
